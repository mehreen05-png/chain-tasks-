# Copy this file to .env and fill it in. NEVER commit .env or share your private key.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Private key of a TEST-ONLY wallet (not your real one), starting with 0x
PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
# Optional: lets the script verify your contract on Etherscan
ETHERSCAN_API_KEY=
