{
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "files.associations": {
    "*.sol": "solidity"
  },
  "solidity.compileUsingRemoteVersion": "v0.8.24",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": false,
    "**/artifacts": false,
    "**/cache": false
  }
}